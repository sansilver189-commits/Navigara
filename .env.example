# ------------------------------------------------------------------
# Navigara dashboard settings.
# Copy this file to a new file called ".env" (same folder) and fill it in.
# The .env file is private: it is never uploaded to GitHub.
# ------------------------------------------------------------------

# Password for the dashboard. Leave empty to run with no login
# (fine while it only runs on your own computer).
DASHBOARD_PASSWORD=

# Your time zone, used for "today" and the analytics charts.
# Examples: America/New_York, America/Chicago, America/Denver, America/Los_Angeles
TIMEZONE=America/New_York

# Port the dashboard runs on (http://localhost:8000). Practice mode uses the next one up.
PORT=8000

# ------------------------------------------------------------------
# Twilio (calling from the browser). Leave empty to use the Dialer as a plain list.
# SETUP.md walks you through where each value comes from.
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
# Any long random text. Put the SAME text in the Twilio Function's DIAL_SECRET setting.
DIAL_SECRET=
# Your Twilio numbers, separated by commas, e.g. +14155550123,+14045550123
TWILIO_NUMBERS=
